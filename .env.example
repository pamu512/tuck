# Guided Memory Lane: Qloo hackathon API key (name only; never commit the value).
# The server reads this key from the environment, with a fallback to
# ~/.config/ax/secrets/qloo-hackathon.env (see README).
QLOO_API_KEY=

# Optional demo retention. Defaults: 86400 seconds, 200 sessions, data/store.json.
# GML_SESSION_TTL_SECONDS=86400
# GML_MAX_SESSIONS=200
# GML_STORE_PATH=data/store.json
