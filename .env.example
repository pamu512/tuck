# Guided Memory Lane: Qloo hackathon API key (name only; never commit the value).
# The server reads this key from the environment, with a fallback to
# ~/.config/ax/secrets/qloo-hackathon.env (see README).
QLOO_API_KEY=

# Optional demo retention. Defaults: 86400 seconds, 200 sessions, data/store.json.
# GML_SESSION_TTL_SECONDS=86400
# GML_MAX_SESSIONS=200
# GML_STORE_PATH=data/store.json

# Sign-in cookie signer. Set this in the server environment. Never commit a value.
# SESSION_SECRET=

# Spotify private playlist (Authorization Code + PKCE). No client secret.
# Leave SPOTIFY_CLIENT_ID empty to use the M3U and search-link export.
# Register this exact redirect URI in the Spotify dashboard (Settings > Redirect URIs).
# Local:  http://127.0.0.1:8000/spotify/callback
# Render: https://guided-memory-lane.onrender.com/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/spotify/callback

# Optional ISO market for Spotify search (e.g. HK, US, GB). Defaults to US
# when /me does not return country (removed from User object Feb 2026).
# SPOTIFY_MARKET=US

